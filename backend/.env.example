# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/psicopedagoga?retryWrites=true&w=majority

# JWT
JWT_SECRET=tu-secreto-super-seguro-cambia-en-produccion
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Redis (para captcha y rate limiting persistente)
REDIS_URL=redis://localhost:6379

# Registro solo por invitación (opcional, si no se define cualquiera puede registrarse)
REGISTER_INVITATION_TOKEN=token-secreto-para-invitaciones

# reCAPTCHA v3 (Google)
RECAPTCHA_SECRET_KEY=tu-recaptcha-secret-key
RECAPTCHA_SITE_KEY=tu-recaptcha-site-key
RECAPTCHA_MIN_SCORE=0.5

# Server
PORT=4000
NODE_ENV=development

# CORS (frontend URL)
FRONTEND_URL=http://localhost:5173